# =============================================================
# ArchiMate AI Generator - Configuración
# Copiá este archivo a .env y completá los valores
# =============================================================

# --- Opción 1: Anthropic Claude (pago, mejor calidad) ---
# Obtené tu clave en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo a usar (opcional, por defecto claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Opción 2: Ollama local (GRATIS, sin internet) ---
# 1. Instalá Ollama desde https://ollama.ai
# 2. Ejecutá: ollama pull llama3.1
# 3. Ejecutá: ollama serve
# 4. La app lo detecta automáticamente si ANTHROPIC_API_KEY está vacío

# Modelo Ollama (opcional, por defecto llama3.1)
OLLAMA_MODEL=llama3.1

# URL de Ollama (opcional, por defecto localhost)
OLLAMA_URL=http://localhost:11434
