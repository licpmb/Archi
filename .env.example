# =============================================================
# ArchiMate AI Generator - Configuración
# Copiá este archivo a ".env" y completá UNA de las opciones
# =============================================================

# ── Opción 1: Anthropic Claude (pago, mejor calidad) ──────────
# Obtené tu clave en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo Claude (opcional, por defecto claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6


# ── Opción 2: Ollama Cloud (RECOMENDADO si tenés la key) ──────
# Creá tu clave en https://ollama.com/settings/keys y pegala acá:
OLLAMA_API_KEY=

# Modelo a usar (por defecto llama3.1)
OLLAMA_MODEL=llama3.1

# URL del cloud de Ollama (no cambiar)
# OLLAMA_URL=https://api.ollama.com


# ── Opción 3: Ollama local (gratis, sin internet, sin API key) ─
# Sin API key, dejá OLLAMA_API_KEY vacío y:
# 1. Instalá Ollama desde https://ollama.ai
# 2. Ejecutá: ollama pull llama3.1
# 3. Ejecutá: ollama serve
# La app lo detecta automáticamente.
# OLLAMA_URL=http://localhost:11434
